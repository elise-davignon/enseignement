c0a90902ed11"],

Cell["Voici un exemple d\[CloseCurlyQuote]impl\[EAcute]mentation :", "Text",
 CellChangeTimes->{{3.915036757700884*^9, 
  3.915036912332409*^9}},ExpressionUUID->"9170cef3-8977-6841-bce6-\
70eb39596b98"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "g", ",", " ", "r", ",", " ", "x", ",", " ", "y", ",", " ", "i", ",", " ", 
    "j"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Euclide\[CapitalEAcute]tendu", "[", 
   RowBox[{"a_", ",", " ", "b_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "g", ",", " ", "r", ",", "  ", "q", ",", " ", "x", ",", " ", "y", ",", 
      " ", "i", ",", " ", "n"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"r", "[", "0", "]"}], "=", "a"}], ";", 
     RowBox[{
      RowBox[{"r", "[", "1", "]"}], "=", "b"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"x", "[", "0", "]"}], "=", "1"}], ";", 
     RowBox[{
      RowBox[{"y", "[", "0", "]"}], "=", "0"}], ";", 
     RowBox[{
      RowBox[{"x", "[", "1", "]"}], "=", "0"}], ";", 
     RowBox[{
      RowBox[{"y", "[", "1", "]"}], "=", "1"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"i", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"r", "[", "i", "]"}], ">", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"q", "[", "i", "]"}], ",", " ", 
           RowBox[{"r", "[", 
            RowBox[{"i", "+", "1"}], "]"}]}], "}"}], "=", 
         RowBox[{"QuotientRemainder", "[", 
          RowBox[{
           RowBox[{"r", "[", 
            RowBox[{"i", "-", "1"}], "]"}], ",", " ", 
           RowBox[{"r", "[", "i", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"x", "[", 
          RowBox[{"i", "+", "1"}], "]"}], "=", 
         RowBox[{
          RowBox[{"x", "[", 
           RowBox[{"i", "-", "1"}], "]"}], "-", 
          RowBox[{
           RowBox[{"q", "[", "i", "]"}], 
           RowBox[{"x", "[", "i", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"y", "[", 
          RowBox[{"i", "+", "1"}], "]"}], "=", 
         RowBox[{
          RowBox[{"y", "[", 
           RowBox[{"i", "-", "1"}], "]"}], "-", 
          RowBox[{
           RowBox[{"q", "[", "i", "]"}], 
           RowBox[{"y", "[", "i", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Cette", " ", "instruction", " ", "imprime", " ", 
          RowBox[{"l", "'"}], "\[EAcute]tape", " ", "de", " ", 
          RowBox[{"l", "'"}], "algorithme"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
          RowBox[{"r", "[", 
           RowBox[{"i", "-", "1"}], "]"}], ",", "\"\< = \>\"", ",", 
          RowBox[{"q", "[", "i", "]"}], ",", " ", "\"\<\[CenterDot]\>\"", ",",
           " ", 
          RowBox[{"r", "[", "i", "]"}], ",", " ", "\"\< + \>\"", ",", " ", 
          RowBox[{"r", "[", 
           RowBox[{"i", "+", "1"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"i", "++"}], ";"}]}], "\[IndentingNewLine]", " ", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"i", "-", "1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"g", "=", 
      RowBox[{"r", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"r", "[", "n", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "[", "n", "]"}], ",", " ", 
          RowBox[{"y", "[", "n", "]"}]}], "}"}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.9150369142817173`*^9, 3.915037098525311*^9}, {
   3.915037195949831*^9, 3.915037242141119*^9}, {3.915037342797676*^9, 
