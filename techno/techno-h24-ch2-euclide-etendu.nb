Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"pgcd", "(", 
    RowBox[{"a", ",", " ", "b"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["x", "n"], " ", "a"}], " ", "+", " ", 
    RowBox[{
     SubscriptBox["y", "n"], " ", "b"}]}]}], TraditionalForm]],
