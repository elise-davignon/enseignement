cd0ca8ca5ffe"],

Cell["\<\
On note peut remonter les \[EAcute]quations pour obtenir le pgcd(a, b) -- ou \
alors, on peut garder une trace des coefficients tout au long du calcul. Par \
exemple, si on \[EAcute]crit\
\>", "Item",
 CellChangeTimes->{{3.9150605255240517`*^9, 3.915060548411106*^9}, {
  3.915060617396103*^9, 3.915060637971781*^9}, {3.915060684275017*^9, 
  3.9150607628424187`*^9}},ExpressionUUID->"3adf8e8e-4926-d94e-9ac1-\
e5066726655b"],

Cell[TextData[Cell[BoxData[{
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["x", "0"], "=", "1"}], ",", " ", 
   RowBox[{
    SubscriptBox["x", "1"], "=", "0"}], ",", " ", 
   RowBox[{
    SubscriptBox["x", 
     RowBox[{"i", "+", "1"}]], "=", 
    RowBox[{
     SubscriptBox["x", 
      RowBox[{"i", "-", "1"}]], "-", 
     RowBox[{
      SubscriptBox["q", "i"], 
      SubscriptBox["x", "i"]}]}]}]}], TraditionalForm], "\[IndentingNewLine]", 
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["y", "0"], "=", "0"}], ",", " ", 
   RowBox[{
    SubscriptBox["y", "1"], "=", "1"}], ",", " ", 
   RowBox[{
    SubscriptBox["y", 
     RowBox[{"i", "+", "1"}]], "=", 
    RowBox[{
     SubscriptBox["y", 
      RowBox[{"i", "-", "1"}]], "-", 
     RowBox[{
      SubscriptBox["q", "i"], 
      SubscriptBox["y", "i"]}]}]}]}], TraditionalForm]}],
 FormatType->
  TraditionalForm,ExpressionUUID->"e753df27-d1e8-394a-9c5d-32d08e4cad9d"]], \
