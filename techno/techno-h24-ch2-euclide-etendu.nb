Cell[CellGroupData[{
Cell["L\[CloseCurlyQuote]algorithme d\[CloseCurlyQuote]Euclide \
\[EAcute]tendu", "Title",
 CellChangeTimes->{{3.9150363914222813`*^9, 
  3.915036395678583*^9}},ExpressionUUID->"31bef1d6-c773-7d43-a381-\
91062b003596"],

Cell[TextData[{
 "On sait par le th\[EAcute]or\[EGrave]me de B\[EAcute]zout que pour des \
nombres entiers ",
 StyleBox["a, b (positifs)",
  FontSlant->"Italic"],
 " il existe toujours deux entiers ",
 StyleBox["x, y",
  FontSlant->"Italic"],
 " tels que"
}], "Text",
 CellChangeTimes->{{3.9150364066856327`*^9, 3.9150364465433197`*^9}, {
  3.9150365635259266`*^9, 
  3.915036566709915*^9}},ExpressionUUID->"522b43b5-0e31-a143-8fa5-\
192a6c5c3103"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"x", " ", "a"}], " ", "+", " ", 
   RowBox[{"y", " ", "b"}]}], " ", "=", " ", 
  RowBox[{"pgcd", 
   RowBox[{"(", 
    RowBox[{"a", ",", " ", "b"}], ")"}]}]}]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.915036459270609*^9, 3.915036500307787*^9}, 
   3.91503673546105*^9},ExpressionUUID->"847cf578-24d6-e14e-8c71-\
c9797d3cf841"],

Cell[TextData[{
 "Pour trouver le pgcd, ainsi que x et y, on applique l\[CloseCurlyQuote]",
 StyleBox["algorithme d\[CloseCurlyQuote]Euclide \[EAcute]tendu.",
  FontWeight->"Bold"],
 " "
}], "Text",
 CellChangeTimes->{{3.915036531134344*^9, 3.9150365576464376`*^9}, 
   3.9150612494005795`*^9},ExpressionUUID->"fde454cd-af19-c24a-bc8b-\
fd034b767eb7"],

Cell[TextData[{
 "On note ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "0"], TraditionalForm]],ExpressionUUID->
  "d44609dc-19a4-934c-89dc-18c4c476ebe2"],
 " = a et ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "1"], " ", "=", " ", "b"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5cb55f77-a4c7-a645-b32b-a16e22edbe3e"],
 "; de fa\[CCedilla]on it\[EAcute]rative, on note :"
}], "Item",
 CellChangeTimes->{{3.915036579669153*^9, 3.915036683189605*^9}, {
  3.91506055980324*^9, 
  3.9150605720267715`*^9}},ExpressionUUID->"15e44f8f-c6c2-a84d-9e7c-\
d181b5029660"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["r", 
    RowBox[{"i", "-", "1"}]], "=", " ", 
   RowBox[{
    RowBox[{
     SubscriptBox["q", "i"], " ", 
     SubscriptBox["r", "i"]}], "+", 
    SubscriptBox["r", 
     RowBox[{"i", "+", "1"}]]}]}], 
  TraditionalForm]],ExpressionUUID->"4c6cc2e0-8401-5244-b3f5-e30093a57d1f"]], \
"DisplayFormulaNumbered",
 CellChangeTimes->{{3.915036701060873*^9, 3.9150367292150135`*^9}, {
  3.915060497214922*^9, 
  3.915060505980852*^9}},ExpressionUUID->"fcc9368b-d800-ad41-9ff5-\
7b3858b6625c"],

Cell[TextData[{
 "o\[UGrave] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "i"], TraditionalForm]],ExpressionUUID->
  "26e93824-eb28-434c-84b7-f99d8aebdd76"],
 " est le quotient de la division de ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", 
    RowBox[{"i", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "35720411-af38-3246-b291-ee092ffa9fb1"],
 " par ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "i"], TraditionalForm]],ExpressionUUID->
  "f26dfc98-b175-6f48-bfcf-8710fa2550aa"],
 "; ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", 
    RowBox[{"i", "+", "1"}]], TraditionalForm]],ExpressionUUID->
  "96a9b6b6-6b77-5648-afe8-06fdd64da082"],
 " est le reste de cette division enti\[EGrave]re. (Si b > a, la premi\
\[EGrave]re \[EAcute]tape ne fera qu\[CloseCurlyQuote]inverser les nombres \
pour nous!)\nL\[CloseCurlyQuote]algorithme s\[CloseCurlyQuote]arr\[EHat]te \
lorsque le reste ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", 
    RowBox[{"n", "+", "1"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c079a582-dd5e-b44a-9b1d-b6309318cabb"],
 " est nul; le reste pr\[EAcute]c\[EAcute]dent ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["r", "n"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "19581481-813c-1941-8339-3280e1e95c80"],
 ") est alors le pgcd. "
}], "Text",
 CellChangeTimes->{{3.915036757700884*^9, 3.915036912332409*^9}, 
   3.91503751378873*^9, {3.915059456359167*^9, 3.9150594852147255`*^9}, {
