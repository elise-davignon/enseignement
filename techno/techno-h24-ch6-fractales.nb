Cell[TextData[{
 "Par exemple, si on a les \[EAcute]quations suivantes :\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"T", "(", 
      RowBox[{"0", ",", " ", "0"}], ")"}], "=", 
     RowBox[{"(", 
      RowBox[{"1", ",", " ", "0"}], ")"}]}], ";", "  ", 
    RowBox[{
     RowBox[{"T", "(", 
      RowBox[{"1", ",", " ", "1"}], ")"}], " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{"2", ",", " ", 
       RowBox[{"-", "1"}]}], ")"}]}], ";", "  ", 
    RowBox[{
     RowBox[{"T", "(", 
      RowBox[{"0", ",", " ", "2"}], ")"}], "=", 
     RowBox[{"(", 
      RowBox[{"3", ",", " ", "1"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a0d79115-2790-e14f-b519-25e4a7e2c1d2"]
}], "Text",
