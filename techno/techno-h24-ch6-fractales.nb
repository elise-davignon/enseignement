cf6c37e854a3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"L", ",", " ", "t"}], "}"}], "=", 
   RowBox[{"TrouverTransformationAffine", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
