        ",", "\"\<.\>\""}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"n", " ", "<", " ", "nmax"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"On", " ", "fait", " ", "une", " ", "it\[EAcute]ration"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"A", " ", "=", " ", 
       RowBox[{"W", "[", 
        RowBox[{"transfos", ",", "A"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"n", "+=", "1"}], ";"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
   RowBox[{
