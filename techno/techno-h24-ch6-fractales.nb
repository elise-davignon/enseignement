Cell[CellGroupData[{
Cell["Transformations affines, fonctions it\[EAcute]r\[EAcute]es, fractales", \
"Title",
 CellChangeTimes->{{3.919292518801409*^9, 
  3.919292526465143*^9}},ExpressionUUID->"fba4d53c-b1b7-a545-9d2b-\
ff0486689432"],

Cell[CellGroupData[{

Cell["Transformations affines", "Section",
 CellChangeTimes->{{3.91929253719314*^9, 
  3.919292539792719*^9}},ExpressionUUID->"2c9df74d-dc89-c648-9bf8-\
eb23f1052222"],

Cell[TextData[{
 "Une ",
 StyleBox["transformation affine",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1e47811b-fdf7-914e-a203-abf91e343390"],
 " est la composition d\[CloseCurlyQuote]une ",
 StyleBox["transformation lin\[EAcute]aire ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox["L", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2998aab7-574f-b044-b8ae-e1cc17e80c5d"],
 " et d\[CloseCurlyQuote]une translation par un vecteur ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4864c4ca-d1b4-4845-b3d3-3297607c1ef9"],
 ".  On peut repr\[EAcute]senter ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "19f58e3d-7e5b-cc43-afe8-29616467d7db"],
 " par une matrice \[LineSeparator]",
 Cell[BoxData[
  FormBox[
   RowBox[{"L", "=", 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["l", "xx"], 
        SubscriptBox["l", "xy"]},
       {
        SubscriptBox["l", "yx"], 
        SubscriptBox["l", "yy"]}
      }], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "93ff90f5-53a6-9e41-bc28-c22bcd9d289e"],
 "\[LineSeparator]et ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ca8acebc-d24a-c242-98d8-97f59724e153"],
 " par un vecteur ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", " ", "=", " ", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["t", "x"], ",", 
      SubscriptBox["t", "y"]}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2285879d-db7f-4d46-ab49-79dec8adaf65"],
 "; Alors,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"T", "(", GridBox[{
       {"x"},
       {"y"}
      }], ")"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", GridBox[{
         {
          SubscriptBox["l", "xx"], 
          SubscriptBox["l", "xy"]},
         {
          SubscriptBox["l", "yx"], 
          SubscriptBox["l", "yy"]}
        }], ")"}], 
      RowBox[{"(", GridBox[{
         {"x"},
         {"y"}
        }], ")"}]}], "+", 
     RowBox[{"(", GridBox[{
        {
         SubscriptBox["t", "x"]},
        {
         SubscriptBox["t", "y"]}
       }], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2e84b70f-a599-ad4b-8c94-29b8db58cace"]
}], "Text",
 CellChangeTimes->{{3.9192925453849583`*^9, 3.9192926933548717`*^9}, {
  3.9192927279152355`*^9, 
  3.9192928217149277`*^9}},ExpressionUUID->"233d8b0e-604c-a24b-be6b-\
6156bc4418b3"],

Cell[TextData[{
 "Il suffit de conna\[IHat]tre les images ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["q", "1"], ",", 
    SubscriptBox["q", "2"], ",", 
    SubscriptBox["q", "3"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a7083487-c22c-1b40-9c00-afa9449027f3"],
 " de trois points ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "1"], ",", " ", 
    SubscriptBox["p", "2"], ",", " ", 
    SubscriptBox["p", "3"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3ec89661-3eb6-264e-b8ee-e669b69aaabf"],
 " par la transformation ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4f203c34-569e-a34f-9e62-6b8eca42fe80"],
 " pour pouvoir la caract\[EAcute]riser compl\[EGrave]tement, en \
r\[EAcute]solvant le syst\[EGrave]me d\[CloseCurlyQuote]\[EAcute]quations\n",
 Cell[BoxData[
  FormBox[
   TagBox[GridBox[{
      {"\[Piecewise]", GridBox[{
         {
          RowBox[{
           RowBox[{"T", "(", 
            SubscriptBox["p", "i"], ")"}], "=", 
           SubscriptBox["q", "i"]}], 
          RowBox[{
           RowBox[{"i", "=", "1"}], ",", " ", "2", ",", " ", "3"}]}
        },
        AllowedDimensions->{2, Automatic},
        Editable->True,
        GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
        GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
        GridBoxSpacings->{"Columns" -> {
            Offset[0.27999999999999997`], {
             Offset[0.84]}, 
            Offset[0.27999999999999997`]}, "Rows" -> {
            Offset[0.2], {
             Offset[0.4]}, 
            Offset[0.2]}},
        Selectable->True]}
     },
     GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
     GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.35]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}],
    "Piecewise",
    DeleteWithContents->True,
    Editable->False,
    SelectWithContents->True,
    Selectable->False,
    StripWrapperBoxes->True], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f5a83542-5447-cc4b-8423-a1130d2ab8de"],
 "\npour les inconnues ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f9ef179e-17c3-9f48-9c13-b872b6796e7b"],
 " et ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ee8d3667-13fe-1d41-b5c6-d70107903d7f"],
 " (il y a six coefficients en tout, et  six \[EAcute]quations).\nCette m\
\[EAcute]thode donne une unique solution lorsque les points ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "54abf25a-afb2-fa42-9509-02e791eeb9f5"],
 " sont non-align\[EAcute]s."
}], "Text",
 CellChangeTimes->{{3.9192929425366116`*^9, 
  3.9192931307185555`*^9}},ExpressionUUID->"25fe74fb-bc36-a542-bf9e-\
b7864b30fb2b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "On", " ", "trouve", " ", "une", " ", "transformation", " ", "affine", " ",
     "\[AGrave]", " ", "partir", " ", "de", " ", "trois", " ", "points", " ", 
    "et", " ", "trois", " ", "images"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"TrouverTransformationAffine", "[", 
      RowBox[{"p_List", ",", " ", "q_List"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "L", ",", " ", "lxx", ",", " ", "lxy", ",", " ", "lyx", ",", " ", 
         "lyy", ",", "t", ",", " ", "tx", ",", " ", "ty", ",", "sol"}], "}"}],
        ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"On", " ", "organise", " ", "nos", " ", "inconnues"}], " ", 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"L", ":=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"lxx", ",", " ", "lxy"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"lyx", ",", " ", "lyy"}], "}"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"t", ":=", 
         RowBox[{"{", 
          RowBox[{"tx", ",", " ", "ty"}], "}"}]}], ";", "\[IndentingNewLine]",
         "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "On", " ", "utilise", " ", "la", " ", "fonction", " ", "Solve", " ", 
          "pour", " ", "r\[EAcute]soudre", " ", "notre", " ", 
          "syst\[EGrave]me", " ", 
          RowBox[{"d", "'"}], "\[EAcute]quations"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"sol", "=", 
         RowBox[{"Solve", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"L", ".", 
                RowBox[{"p", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], "+", "t"}], "==", 
              RowBox[{"q", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Flatten", "@", 
            RowBox[{"{", 
             RowBox[{"L", ",", " ", "t"}], "}"}]}]}], " ", 
          RowBox[{"(*", " ", 
           RowBox[{"Notre", " ", "liste", " ", 
            RowBox[{"d", "'"}], "inconnues"}], " ", "*)"}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "On", " ", "retourne", " ", "une", " ", "liste", " ", "contenant", "\[IndentingNewLine]",
            "1.", " ", "La", " ", "matrice", " ", "L"}], ";", 
          "\[IndentingNewLine]", " ", 
          RowBox[{"2.", " ", "Le", " ", "vecteur", " ", "t"}]}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"Return", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"L", ",", " ", "t"}], "}"}], "/.", 
          RowBox[{"sol", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Cette", " ", "fonction", " ", "applique", " ", "la", " ", 
     "transformation", " ", "affine", " ", "transfo", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
       "donn\[EAcute]e", " ", "comme", " ", "une", " ", "liste", " ", 
        "contenant", " ", "la", " ", "matrice", " ", "L", " ", "et", " ", 
        "le", " ", "vecteur", " ", "t"}], ")"}], "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"AppliquerT", "[", 
      RowBox[{"transfo_", ",", "point_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"transfo", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ".", "point"}], "+", 
      RowBox[{"transfo", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}]}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.919166194996668*^9, 3.919166242301667*^9}, {
   3.919166760977097*^9, 3.9191669183185*^9}, {3.919166956222956*^9, 
   3.919167093858473*^9}, {3.9191672103086624`*^9, 3.919167301640972*^9}, {
   3.919167607458896*^9, 3.919167639739273*^9}, {3.9191678167442265`*^9, 
