Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"On", " ", "dessine", " ", "A"}], ",", " ", 
    RowBox[{
    "puis", " ", "on", " ", "calcule", " ", "la", " ", "prochaine", " ", 
     "it\[EAcute]ration"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"temps1", "=", 
     RowBox[{"SessionTime", "[", "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
