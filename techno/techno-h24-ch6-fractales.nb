Cell[CellGroupData[{

Cell["Facteurs de contraction et dimensions fractales", "Section",
 CellChangeTimes->{{3.9195617134276733`*^9, 3.919561716355812*^9}, {
  3.919561955474806*^9, 
  3.9195619610673275`*^9}},ExpressionUUID->"d5921ccc-fe49-534e-85cd-\
ab9a799f737e"],

Cell[CellGroupData[{

Cell["Facteurs de contraction", "Subsection",
 CellChangeTimes->{{3.919562812073433*^9, 
  3.9195628150321274`*^9}},ExpressionUUID->"30a42b36-7704-8248-8877-\
1a170b795849"],

Cell[TextData[{
 "Le ",
 StyleBox["facteur de contraction",
  FontWeight->"Bold"],
 " d\[CloseCurlyQuote]une transformation affine ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d503f46c-aa16-ab48-999f-19e4ccca07c1"],
 " est un nombre ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a1b7b81f-b951-3245-9e15-c675fd9995e7"],
 " tel que pour tous vecteurs ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", ",", " ", "y"}],
    FontWeight->"Bold"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fa16d1c3-ca0e-3049-bb5b-6b12791f602a"],
 ", on a que\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"d", "(", 
     RowBox[{
      RowBox[{"T", "(", 
       StyleBox["x",
        FontWeight->"Bold"], ")"}], ",", " ", 
      RowBox[{"T", "(", 
       StyleBox["y",
        FontWeight->"Bold"], ")"}]}], ")"}], " ", "<=", " ", 
    RowBox[{"r", " ", 
     RowBox[{"d", "(", 
      RowBox[{
       StyleBox["x",
        FontWeight->"Bold"], ",", " ", 
       StyleBox["y",
        FontWeight->"Bold"]}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "483f0f86-78ba-3b43-b942-cffabf0575dc"],
 ";\nc\[CloseCurlyQuote]est un ",
 StyleBox["facteur de contraction exact",
  FontWeight->"Bold"],
 " lorsque l\[CloseCurlyQuote]on a l\[CloseCurlyQuote]\[EAcute]galit\[EAcute] \
pour tous ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"x", ",", " ", "y"}],
    FontWeight->"Bold"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2ea286c7-b816-6447-b490-545bd9e0fcc1"],
 "."
}], "Text",
 CellChangeTimes->{{3.9195619685622807`*^9, 
  3.9195621371221905`*^9}},ExpressionUUID->"1382bd1a-a4a5-434a-8005-\
08084e4f90a8"],

Cell[TextData[{
 "\[CapitalAGrave] l\[CloseCurlyQuote]aide d\[CloseCurlyQuote]un peu d\
\[CloseCurlyQuote]alg\[EGrave]bre lin\[EAcute]aire, on voit rapidement que si \
",
 Cell[BoxData[
  FormBox["L", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0f70f7cf-4d2d-e843-b201-27bf3151d871"],
 " est la partie lin\[EAcute]aire de ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "54d610e1-38c6-5f4c-b435-48b652e2b40a"],
 ",\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", " ", "=", " ", 
    RowBox[{"max", 
     RowBox[{"{", " ", 
      RowBox[{
       RowBox[{"|", "\[Lambda]", "|"}], " ", ":", " ", 
       RowBox[{"\[Lambda]", " ", "est", " ", "une", " ", 
        RowBox[{"val", ".", " ", "propre"}], " ", "de", " ", "L"}]}], 
      "}"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "61f4e627-d663-c845-b032-1755e2accea1"]
}], "Text",
 CellChangeTimes->{{3.9195621527541943`*^9, 
  3.9195622260501633`*^9}},ExpressionUUID->"091ab57d-ad1a-8c4b-a9e9-\
47e415524c43"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "On", " ", "d\[EAcute]finit", " ", "le", " ", "facteur", " ", "de", " ", 
    "contraction"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"FacteurDeContraction", "[", "transfo_", "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{"Max", "@", 
      RowBox[{"(", 
       RowBox[{"Abs", "/@", 
        RowBox[{"Eigenvalues", "[", 
         RowBox[{"transfo", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ContractionExacteQ", "[", "transfo_", "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Max", "[", "#", "]"}], "-", 
           RowBox[{"Min", "[", "#", "]"}]}], ")"}], "&"}], "@", 
        RowBox[{"(", 
         RowBox[{"Abs", "/@", 
          RowBox[{"Eigenvalues", "[", 
           RowBox[{"transfo", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ")"}]}], ")"}], "==", 
      "0"}]}], ";"}]}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.919562233576565*^9, 3.919562374730213*^9}, {
  3.919562447618999*^9, 3.9195624681623745`*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"8ef3f55d-3052-c242-9ef8-41e61ae2b1f1"],

