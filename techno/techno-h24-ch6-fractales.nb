Cell[TextData[{
 StyleBox["Exercice 1 b. ",
  FontWeight->"Bold"],
 "Une fa\[CCedilla]on triviale de produire un second ensemble de \
transformations est de simplement donner des transformations qui sont \
\[EAcute]quivalentes \[AGrave] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"W", "(", 
    RowBox[{"W", "(", "A", ")"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "aeb734ec-4420-5341-b809-06d2e5d899da"],
 ". Par exemple ,  pour la fractale de la figure 11.12 (b) :"
}], "Text",
