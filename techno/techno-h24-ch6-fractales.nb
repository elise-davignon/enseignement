Cell["Voici une repr\[EAcute]sentation visuelle de la transformation :", \
"Text",
 CellChangeTimes->{{3.9192945124985256`*^9, 
  3.9192945204976864`*^9}},ExpressionUUID->"aaf5df4c-07b5-0a49-b07e-\
8177da594733"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Graphics", "[", 
    RowBox[{"{", 
     RowBox[{"Red", ",", " ", 
      RowBox[{"Line", "[", 
       RowBox[{"Append", "[", 
        RowBox[{"p", ",", " ", 
