Cell[CellGroupData[{

Cell["Un algorithme qui dessine \[LeftGuillemet]\[NonBreakingSpace]plus \
\[EAcute]gal \[RightGuillemet]", "Subsection",
 CellChangeTimes->{{3.9192997372586575`*^9, 3.919299744162754*^9}, {
  3.91930251596266*^9, 
  3.9193025216101246`*^9}},ExpressionUUID->"7609f574-fcfb-7a43-a7e3-\
2d84c3d345fa"],

Cell[TextData[{
 "L\[CloseCurlyQuote]algorithme suivant g\[EAcute]n\[EGrave]re le dessin de \
la fractale en appliquant des transformations al\[EAcute]atoires au dernier \
point de la liste de points ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5e79e4a7-9a7b-dc4a-a3b2-53d440c78453"],
 ". Les probabilit\[EAcute]s des transformations sont choisies environ \
proportionnellement \[AGrave] la valeur absolue de leurs \
d\[EAcute]terminants, histoire que les points soient distribu\[EAcute]s plus \
\[EAcute]quitablement dans le dessin.\n\nCet algorithme est (\[AGrave] \
quelques modifications pr\[EGrave]s) ce qui est donn\[EAcute] dans le manuel \
pour tracer la foug\[EGrave]re."
}], "Text",
 CellChangeTimes->{{3.9192974734740944`*^9, 3.9192974805780087`*^9}, {
  3.919299059516823*^9, 3.9192991837725315`*^9}, {3.9192997481704636`*^9, 
  3.919299841058508*^9}},ExpressionUUID->"e0ec5e9b-731c-7446-9e92-\
66750341a2ac"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "On", " ", "calcule", " ", "des", " ", "poids", " ", "pour", " ", "les", " ",
     "transformations", " ", "affines", " ", "de", " ", "la", " ", "liste", " ",
     "transfos"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"PoidsTransfos", "[", "transfos_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dets", ",", " ", "totalDets"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"dets", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"Det", "[", 
             RowBox[{"transfos", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "]"}], " ", ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "1", ",", " ", 
             RowBox[{"Length", "[", "transfos", "]"}]}], "}"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"totalDets", "=", 
         RowBox[{"Total", "[", "dets", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"dets", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"#", "+", 
             RowBox[{".01", 
              RowBox[{"(", "totalDets", ")"}]}]}], ")"}], "&"}], "/@", 
          "dets"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", 
         RowBox[{"dets", "/", 
          RowBox[{"Total", "[", "dets", "]"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PoidsTransfosEqui", "[", "transfos_", "]"}], ":=", 
     RowBox[{
      RowBox[{"Array", "[", 
       RowBox[{
        RowBox[{"1", "&"}], ",", 
        RowBox[{"Length", "[", "transfos", "]"}]}], "]"}], "/", 
      RowBox[{"Length", "[", "transfos", "]"}]}]}], ";"}]}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.919298320779037*^9, 3.919298588487458*^9}, {
   3.919298625119367*^9, 3.919298629207615*^9}, {3.919299189509737*^9, 
