Cell[CellGroupData[{

Cell["Dimension fractale", "Subsection",
 CellChangeTimes->{{3.9195628475282288`*^9, 
  3.9195628503600616`*^9}},ExpressionUUID->"f85df5be-a701-c14f-9e14-\
00e205654248"],

Cell[TextData[{
 "La ",
 StyleBox["dimension fractale",
  FontWeight->"Bold"],
 " d\[CloseCurlyQuote]une r\[EAcute]gion du plan (ou de \
l\[CloseCurlyQuote]espace) est d\[EAcute]finie comme\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["lim", 
      RowBox[{"n", "->", "\[Infinity]"}]], " ", 
     FractionBox[
      RowBox[{"log", " ", 
       RowBox[{"N", "(", 
        RowBox[{"1", "/", "n"}], ")"}]}], 
      RowBox[{"log", " ", "n"}]]}], "=", 
    RowBox[{"dim", "(", "A", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1bfa224e-96cb-994c-b79c-47864a01ee65"],
 ",\no\[UGrave] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "(", 
    RowBox[{"1", "/", "n"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fc5a6ad6-40a1-e348-84cc-50e69c23ad76"],
 " est le nombre de carr\[EAcute]s (ou de cubes) de c\[OHat]t\[EAcute] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "n"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "51a2e5ea-0a4e-9a4d-8bdb-e76f20f6a3bc"],
 " requis pour couvrir la r\[EAcute]gion ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c468d84d-d584-c94b-8a6d-c1fa044a34af"],
 "."
}], "Text",
 CellChangeTimes->{{3.9195617470514297`*^9, 
  3.91956183512422*^9}},ExpressionUUID->"9af37bf4-d387-7c4f-9901-\
24b0ba4a327a"],

Cell[TextData[{
 "Si les transformations affines ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0c408a40-4864-ea42-8796-781919e7dcc2"],
 " ont toutes des facteurs de contraction exacts ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "07c4ff7f-72f2-5b47-929f-bca45a49e333"],
 ", pour ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", " ", "...", ",", " ", "n"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ac5de0ec-ccb8-6b47-a712-6d594f7a07c2"],
 ", alors le point fixe ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4a59a231-9d1b-5b40-94e5-82d5a051ef78"],
 " compact du syst\[EGrave]me de fonctions it\[EAcute]r\[EAcute]es ",
 Cell[BoxData[
  FormBox[
   RowBox[{"W", "=", 
    RowBox[{
     SubscriptBox["\[Union]", "i"], 
     SubscriptBox["T", "i"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "143f2242-4a9c-d147-b609-f4d0e1c38f5f"],
 "  a la dimension fractale ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", " ", "A"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "57bdf85e-7c01-c247-84c4-40e16147817f"],
 " qui satisfait :\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Sum]", "i"], 
     SuperscriptBox[
      SubscriptBox["r", "i"], 
      RowBox[{"dim", " ", "A"}]]}], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a2aa4b8f-a9e0-1b45-9bf4-46a919f8be60"]
}], "Text",
 CellChangeTimes->{{3.9195628612878647`*^9, 
  3.9195630158658752`*^9}},ExpressionUUID->"3776b939-6fbb-f749-81b1-\
53beeaba36cd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DimensionFractale", "[", "transfos_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", ",", "sol"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ContractionExacteQ", "/@", "transfos"}], "!=", 
        RowBox[{"Array", "[", 
         RowBox[{
          RowBox[{"True", "&"}], ",", 
          RowBox[{"Length", "[", "transfos", "]"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
        "Print", 
         "[", "\"\<Les transformations n'ont pas toutes des facteurs de \
contraction exacts.\>\"", "]"}], ";"}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Si", " ", "les", " ", "facteurs", " ", "de", " ", "contraction", " ",
          "sont", " ", "tous", " ", "exacts"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"r", "=", 
         RowBox[{"FacteurDeContraction", "/@", "transfos"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sol", "=", 
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Total", "[", 
             SuperscriptBox["r", "dim"], "]"}], "==", "1"}], ",", "dim", ",", 
           "Reals"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", 
         RowBox[{"dim", "/.", 
          RowBox[{"sol", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}]}], "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.919563034388691*^9, 3.919563065456459*^9}, {
  3.9195631075847187`*^9, 3.9195632161759224`*^9}, {3.9195632611116886`*^9, 
  3.919563357440248*^9}, {3.919563550222958*^9, 3.9195635595662174`*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"5549392d-baaa-6645-8739-53cd8a7676da"],

