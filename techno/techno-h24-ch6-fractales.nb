Cell[CellGroupData[{

Cell["Le m\[EHat]me algorithme, \[AGrave] r\[EAcute]p\[EAcute]tition.", \
"Subsection",
 CellChangeTimes->{{3.919301074542164*^9, 
  3.919301084757759*^9}},ExpressionUUID->"4c97044c-9588-3d4b-9cbf-\
48c2e9fff85d"],

Cell["\<\
Le morceau de code suivant g\[EAcute]n\[EGrave]re la fractale par \
it\[EAcute]rations comme pr\[EAcute]c\[EAcute]demment, mais en bouclant tout \
d\[CloseCurlyQuote]un coup. Pour limiter le nombre d\[CloseCurlyQuote]it\
\[EAcute]rations on peut d\[EAcute]terminer un maximum \[AGrave] partir du \
nombre de points qu\[CloseCurlyQuote]on veut\
\>", "Text",
 CellChangeTimes->{{3.919301094150341*^9, 3.9193011123107014`*^9}, {
  3.9193012411183434`*^9, 
  3.9193012576298904`*^9}},ExpressionUUID->"84b9f363-4fef-4143-ba64-\
3c6e7a892128"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "La", " ", "fonction", " ", "NMax", " ", "retourne", " ", "le", " ", 
    "nombre", " ", "minimum", " ", 
    RowBox[{"d", "'"}], "it\[EAcute]rations", " ", 
    RowBox[{"qu", "'"}], "il", " ", "faut", " ", "faire", " ", "pour", " ", 
    "avoir", " ", "npoints", " ", "points", " ", "avec", " ", "les", " ", 
    "transformations", " ", "transfos"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"NMax", "[", 
     RowBox[{"transfos_", ",", "npoints_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "nt", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"nt", "=", 
        RowBox[{"Length", "[", "transfos", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"nt", ">", "1"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Ceiling", "[", 
           RowBox[{
            RowBox[{"Log", "[", "npoints", "]"}], "/", 
            RowBox[{"Log", "[", "nt", "]"}]}], "]"}], ",", 
          "\[IndentingNewLine]", "npoints"}], "\[IndentingNewLine]", "]"}], 
        "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.919301266193769*^9, 3.9193013453987484`*^9}, {
  3.91930137885458*^9, 3.9193014034065113`*^9}, {3.9194405576249065`*^9, 
  3.919440613713684*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"78ad9bfc-9d5d-cc41-b19c-861eb66b6a48"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"L", "'"}], "algorithme", " ", "de", " ", "dessin", " ", "de", " ",
     "fractale"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"DessinerFractale", "[", 
      RowBox[{"transfos_List", ",", "nPoints_", ",", "init_"}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "temps1", ",", " ", "temps2", ",", " ", "A", ",", " ", "n", ",", " ", 
         "nmax", ",", " ", "lp"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"temps1", "=", 
         RowBox[{"SessionTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"A", "=", "init"}], ";", "\[IndentingNewLine]", 
        RowBox[{"n", "=", "0"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"nmax", "=", 
         RowBox[{"NMax", "[", 
          RowBox[{"transfos", ",", " ", "100000"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<nmax = \>\"", ",", "nmax"}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"n", "<", "nmax"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"A", "=", 
            RowBox[{"W", "[", 
             RowBox[{"transfos", ",", "A"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"n", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"lp", "=", 
         RowBox[{"ListPlot", "[", 
          RowBox[{"A", ",", 
           RowBox[{"AspectRatio", "->", "Automatic"}], ",", 
           RowBox[{"Frame", "->", "True"}], ",", " ", 
           RowBox[{"Axes", "->", "False"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"ImageSize", "->", "Medium"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
          RowBox[{"Length", "[", "A", "]"}], ",", "\"\< point\>\"", ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "A", "]"}], ">", "1"}], ",", "\"\<s.\>\"",
             ",", "\"\<.\>\""}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"temps2", "=", 
         RowBox[{"SessionTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
          RowBox[{"temps2", "-", "temps1"}], ",", "\"\< secondes.\>\""}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "lp", "]"}]}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"origine", "=", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"0.", ",", " ", "0."}], "}"}], "}"}]}], ";"}]}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.919301113553777*^9, 3.9193012379042053`*^9}, {
