Cell[CellGroupData[{

Cell["Syst\[EGrave]mes de fonctions it\[EAcute]r\[EAcute]es et fractales", \
"Section",
 CellChangeTimes->{{3.9192945914106464`*^9, 3.919294602866352*^9}, {
  3.91929993002647*^9, 
  3.919299931625988*^9}},ExpressionUUID->"c75f72c4-3c60-4a45-a12d-\
8b0055366c82"],

Cell[TextData[{
 "Soit ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "419f2de1-d113-e743-b5a4-ddd1e1cbda4c"],
 " une r\[EAcute]gion du plan, et soient ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "1"], ",", " ", 
    SubscriptBox["T", "2"], ",", " ", 
    SubscriptBox["T", "3"], ",", " ", "...", ",", " ", 
    SubscriptBox["T", "n"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a1414697-b1aa-9446-ada5-979062075c2d"],
 " des transformations affines. On note\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"W", "(", "A", ")"}], " ", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["T", "1"], "(", "A", ")"}], " ", "\[Union]", " ", 
       RowBox[{
        SubscriptBox["T", "2"], "(", "A", ")"}], " ", "\[Union]", " ", 
       RowBox[{
        SubscriptBox["T", "3"], "(", "A", ")"}], " ", "\[Union]"}], " ", 
      "..."}], " ", "\[Union]", " ", 
     RowBox[{
      SubscriptBox["T", "n"], " ", 
      RowBox[{"(", "A", ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b4bac02b-d2f6-4946-b6bb-f12a992dcebf"]
}], "Text",
 CellChangeTimes->{{3.9192946169388866`*^9, 3.9192946759723225`*^9}, {
  3.919294712885521*^9, 
  3.9192948043947124`*^9}},ExpressionUUID->"37b95deb-4008-a245-a1d1-\
ec7f3341f6fd"],

Cell[TextData[{
 "La fonction ",
 Cell[BoxData[
  FormBox["W", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "06490d3c-475c-c347-b6ab-7fd884e74c35"],
 " est une fonction d\[CloseCurlyQuote]ensembles qui, partant de ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5dd3aff6-7517-0a43-9932-7c531de34a13"],
 ", cr\[EAcute]e ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ca1451e0-3c43-fd4a-aeb4-b122830b005a"],
 " copies de ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "989b661a-45c8-a747-9cdd-be8b8668dcda"],
 " transform\[EAcute]es par les transformations affines ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "18272643-f6d8-2c48-9be6-4e6bccbdfa64"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", " ", "2", ",", " ", "3", ",", " ", "...", 
    ",", " ", "n"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c9093d96-f198-934d-a977-07c3c7163988"],
 ". "
}], "Text",
 CellChangeTimes->{{3.9192948292179604`*^9, 
  3.919294890833599*^9}},ExpressionUUID->"4b9ab804-5466-774b-8f43-\
1d3750bc9f1f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"W", "[", 
    RowBox[{"transfos_List", ",", "A_"}], "]"}], ":=", 
   RowBox[{"Join", "@@", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"AppliquerT", "[", 
         RowBox[{
          RowBox[{"transfos", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
       "A"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", "transfos", "]"}]}], "}"}]}], 
     "\[IndentingNewLine]", "]"}]}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9192949322063465`*^9, 3.919294983578117*^9}, {
  3.919295017249803*^9, 3.919295143465843*^9}, {3.919295616544557*^9, 
  3.9192956169365807`*^9}, {3.9192956498166733`*^9, 3.919295657944727*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"6f4d0166-f8b5-0f40-b88e-3a26b0a3215e"],

Cell[TextData[{
 "Lorsque W est une ",
 StyleBox["contraction ",
  FontWeight->"Bold"],
 "(c\[CloseCurlyQuote]est-\[AGrave]-dire que les images de deux points par \
les ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2b3a5eba-fbf2-974e-9f38-9129ea713aa9"],
 " sont toujours plus proches que les points de d\[EAcute]part), elle poss\
\[EGrave]de un ",
 StyleBox["point fixe",
  FontWeight->"Bold"],
 " qui satisfait A = W(A). La nature auto-r\[EAcute]plicative de A (qui \
contient plusieurs images de lui-m\[EHat]me) fait des fractales.\nLes it\
\[EAcute]r\[EAcute]s d\[CloseCurlyQuote]un ensemble de d\[EAcute]part sous ",
 Cell[BoxData[
  FormBox["W", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1d55032f-694a-6b45-aa3a-7995cab4296e"],
 " convergent vers cette fractale."
}], "Text",
 CellChangeTimes->{{3.919295219329138*^9, 
  3.919295353136799*^9}},ExpressionUUID->"53cc3d85-9f25-0049-8a35-\
6f5d672a9ff0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Liste", " ", "des", " ", "transformations", " ", "affines"}], " ",
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"transfos", "=", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"L", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"1", "/", "2"}], ",", " ", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", 
             RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"L", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "4"}], ",", 
          RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"L", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "2"}], ",", " ", "0"}], "}"}]}], "}"}]}], 
     "\[IndentingNewLine]", "}"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.919295360548574*^9, 3.9192954857927227`*^9}, 
   3.9192955327528887`*^9, {3.919295723064197*^9, 3.91929572960029*^9}, {
   3.919296371343399*^9, 3.919296374222341*^9}, 3.919297035220415*^9, 
   3.91929730933119*^9, {3.919297506851343*^9, 3.91929754037027*^9}, {
   3.919299303133337*^9, 3.9192993261814346`*^9}, {3.919560251745743*^9, 
   3.9195602520489216`*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"101c2edd-f2d8-0142-bed1-f74a0e62cdb6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "Initialisation", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"A", "=", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"0.", ",", " ", "0."}], "}"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "0"}], ";", 
    RowBox[{"nmax", "=", "10"}], ";"}]}]}]], "Input",
