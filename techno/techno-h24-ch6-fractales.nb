Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Algorithme", " ", "stochastique"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"DessinerFractaleStocha", "[", 
     RowBox[{"transfos_", ",", "nPoints_", ",", "init_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "temps1", ",", " ", "temps2", ",", " ", "transfoAl\[EAcute]atoire", ",",
         "dernierPoint", ",", "A", ",", " ", "lp"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"temps1", "=", 
        RowBox[{"SessionTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "On", " ", "choisira", " ", "chaque", " ", "fois", " ", "une", " ", 
          "transfo", " ", 
          RowBox[{"al\[EAcute]atoire", ".", " ", "Le"}]}], " ", ":=", " ", 
         RowBox[{
         "signifie", " ", "que", " ", "le", " ", "choix", " ", 
          "al\[EAcute]atoire", " ", "se", " ", "fait", " ", "chaque", " ", 
          "fois", " ", "que", " ", "le", " ", "symbole", " ", "est", " ", 
          RowBox[{"utilis\[EAcute]", "."}]}]}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"transfoAl\[EAcute]atoire", ":=", 
        RowBox[{"RandomChoice", "[", 
         RowBox[{
          RowBox[{"PoidsTransfos", "[", "transfos", "]"}], "->", "transfos"}],
          "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"dernierPoint", "=", "init"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Les", " ", "fonctions", " ", "Reap", " ", "et", " ", "Sow", " ", 
         "sont", " ", "beaucoup", " ", "plus", " ", "efficaces", " ", "que", " ",
          "AppendTo", " ", "pour", " ", "la", " ", 
         "g\[EAcute]n\[EAcute]ration", " ", "it\[EAcute]rative", " ", 
         RowBox[{"d", "'"}], "une", " ", "liste"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"A", "=", 
        RowBox[{
         RowBox[{"Reap", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Do", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Sow", "[", "\[IndentingNewLine]", 
              RowBox[{"dernierPoint", "=", 
               RowBox[{"AppliquerT", "[", 
                RowBox[{"transfoAl\[EAcute]atoire", ",", "dernierPoint"}], 
                "]"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
             ",", 
             RowBox[{"{", 
              RowBox[{"nPoints", "-", "1"}], "}"}]}], "]"}], ";"}], 
          "\[IndentingNewLine]", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"A", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", "init", "}"}], ",", 
          RowBox[{"A", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", " ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "La", " ", "fonction", " ", "Reap", " ", "renvoie", " ", "un", " ", 
         "format", " ", "peu", " ", 
         RowBox[{"pratique", ".", " ", "On"}], " ", "corrige", " ", 
         RowBox[{"\[CCedilla]a", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"lp", "=", 
        RowBox[{"ListPlot", "[", 
         RowBox[{"A", ",", 
          RowBox[{"AspectRatio", "->", "Automatic"}], ",", 
          RowBox[{"Frame", "->", "True"}], ",", " ", 
