          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"ImageSize", "->", "Medium"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{"Length", "[", "A", "]"}], ",", "\"\< point\>\"", ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "A", "]"}], ">", "1"}], ",", "\"\<s.\>\"", 
           ",", "\"\<.\>\""}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"temps2", "=", 
        RowBox[{"SessionTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{"temps2", "-", "temps1"}], ",", "\"\< secondes.\>\""}], 
        "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "lp", "]"}]}]}], "\[IndentingNewLine]", "]"}]}],
    ";"}]}]], "Input",
