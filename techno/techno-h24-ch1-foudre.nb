Cell[CellGroupData[{

Cell["Triangulation par hyperboles", "Section",
 CellChangeTimes->{{3.9144382819319687`*^9, 
  3.914438285852316*^9}},ExpressionUUID->"d2d678b9-b64f-324f-9e5d-\
89e4893b3469"],

Cell[TextData[{
 "En regardant les diff\[EAcute]rences de distances entre les temps de \
parcours, on peut conna\[IHat]tre les ",
 StyleBox["diff\[EAcute]rences de distances",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", 
    RowBox[{"i", ",", " ", "j"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e0765c38-16e9-544a-af0a-1b1db954f496"],
 " ",
 "de ",
 StyleBox["X",
  FontSlant->"Italic"],
 " \[AGrave] deux antennes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "524cd474-ae14-6340-b9d7-3a84e26c1a88"],
 " et ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "j"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "753b40a1-0ac6-9542-bcb0-4d5f55af122a"],
 "; cela nous permet d\[CloseCurlyQuote]\[EAcute]tablir que le point se situe \
sur une ",
 StyleBox["hyperbole.",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.914438294108055*^9, 3.914438338083208*^9}, {
  3.91443837604385*^9, 3.9144384146350727`*^9}, {3.9144384534115143`*^9, 
  3.9144384576107426`*^9}, {3.914439389944193*^9, 
  3.914439410610861*^9}},ExpressionUUID->"2825e852-6529-284a-a235-\
41f384dc080c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{
        SubscriptBox["\"\<\[Delta]\>\"", 
         RowBox[{"i", ",", " ", "j"}]], ",", " ", "\"\< = \>\"", ",", " ", 
        "\[IndentingNewLine]", 
        RowBox[{
         SubscriptBox["\[Delta]", 
          RowBox[{"i", ",", " ", "j"}]], "=", 
         RowBox[{"Abs", "[", 
          RowBox[{"vitesse", 
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["t", "i"], "-", 
             SubscriptBox["t", "j"]}], ")"}]}], "]"}]}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", 
        RowBox[{"i", "+", "1"}], ",", " ", "n"}], "}"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "1", ",", " ", "n"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r", "=", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "y"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gHyperboles", " ", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SubscriptBox["gH", 
         RowBox[{"i", ",", " ", "j"}]], "=", 
        RowBox[{"ContourPlot", "[", 
         RowBox[{
          RowBox[{
           SuperscriptBox[
            SubscriptBox["\[Delta]", 
             RowBox[{"i", ",", " ", "j"}]], "2"], "==", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Norm", "[", 
               RowBox[{"r", "-", 
                SubscriptBox["P", "i"]}], "]"}], "-", 
              RowBox[{"Norm", "[", 
               RowBox[{"r", "-", 
                SubscriptBox["P", "j"]}], "]"}]}], ")"}], "2"]}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", 
            RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"y", ",", " ", 
            RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", " ", 
          RowBox[{"ContourStyle", "->", "Red"}], ",", 
          RowBox[{"PlotPoints", "->", "200"}]}], "]"}]}], " ", ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", 
         RowBox[{"i", "+", "1"}], ",", " ", "n"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "1", ",", " ", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   SubscriptBox["gP", "1"], ",", " ", 
   SubscriptBox["gP", "2"], ",", " ", 
   SubscriptBox["gH", 
    RowBox[{"1", ",", " ", "2"}]]}], "]"}]}], "Input",
 CellChangeTimes->{{3.914438469616947*^9, 3.9144391327787476`*^9}, {
  3.914439240684105*^9, 3.914439272857897*^9}, {3.914439349243859*^9, 
