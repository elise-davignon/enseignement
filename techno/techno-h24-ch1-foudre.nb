Cell[TextData[{
 "Au temps T (inconnu), un ",
 StyleBox["\[EAcute]clair",
  FontWeight->"Bold"],
 " frappe \[AGrave] une position X (inconnue), et cr\[EAcute]e une ",
 StyleBox["onde",
  FontWeight->"Bold"],
 " d\[CloseCurlyQuote]amplitude A (inconnue). Les antennes \
re\[CCedilla]oivent des ",
 StyleBox["signaux",
  FontWeight->"Bold"],
 " (ici, on les simule pour le fun... ) et on va utiliser les signaux re\
\[CCedilla]us (temps ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f3ae153e-f402-f442-a8bd-01e14c016c80"],
 " et amplitudes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b011b21f-d82b-ac46-8370-a73109eb531f"],
 ") pour d\[EAcute]terminer d\[CloseCurlyQuote]o\[UGrave] ces signaux \
proviennent."
}], "Text",
 CellChangeTimes->{{3.9144360988748264`*^9, 3.914436144218647*^9}, {
  3.9144382045570354`*^9, 
  3.9144382749162903`*^9}},ExpressionUUID->"e071f5e5-84ae-e741-9f90-\
2182f0541bb7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Forme", " ", "de", " ", 
    RowBox[{"l", "'"}], "onde"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"onde", "[", "t_", "]"}], ":=", 
    RowBox[{"Piecewise", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"2", "\[Pi]", " ", "t"}], "]"}], " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"-", " ", "t"}], "]"}]}], ",", " ", 
         RowBox[{"t", ">", "0"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "True"}], "}"}]}], "}"}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Temps", ",", " ", "amplitude", ",", " ", 
     RowBox[{"position", " ", "de", " ", 
      RowBox[{"l", "'"}], 
      RowBox[{"\[EAcute]clair", " ", "--"}], " ", "toutes", " ", 
      "inconnues"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"T", "=", 
     RowBox[{"RandomReal", "[", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"A", "=", 
     RowBox[{"RandomReal", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"X", "=", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", " ", "2"}], "]"}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Les", " ", "distances", " ", "de", " ", 
     RowBox[{"l", "'"}], "\[EAcute]clair", " ", 
     RowBox[{"(", "inconnues", ")"}], " ", "et", " ", "les", " ", "temps", " ",
      "o\[UGrave]", " ", "on", " ", "re\[CCedilla]oit", " ", "les", " ", 
     RowBox[{"signaux", ".", " ", "On"}], " ", "assume", " ", "que", " ", 
     "les", " ", "signaux", " ", "vont", " ", "\[AGrave]", " ", "une", " ", 
     "vitesse", " ", "de", " ", "5", " ", 
     RowBox[{"u", "/", "s"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vitesse", " ", "=", " ", "5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       SubscriptBox["d", "i"], "=", 
       RowBox[{"Norm", "[", 
        RowBox[{"X", "-", 
         SubscriptBox["P", "i"]}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "1", ",", " ", "n"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{
        SubscriptBox["\"\<t\>\"", "i"], ",", " ", "\"\< = \>\"", ",", " ", 
        RowBox[{
         SubscriptBox["t", "i"], "=", 
         RowBox[{"T", "+", 
          RowBox[{
           SubscriptBox["d", "i"], "/", "vitesse"}]}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "1", ",", " ", "n"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       SubscriptBox["a", "i"], "=", 
       FractionBox[
        RowBox[{"5", " ", "A"}], 
        SuperscriptBox[
         SubscriptBox["d", "i"], "2"]]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "1", ",", " ", "n"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "On", " ", "imprime", " ", "les", " ", "signaux", " ", "re\[CCedilla]us", 
     " ", "par", " ", "les", " ", "diff\[EAcute]rentes", " ", "antennes"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{"Transpose", "@", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         SubscriptBox["\"\<Signal \[AGrave] P\>\"", "i"], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "1", ",", " ", "n"}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"plots", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Plot", "[", 
           RowBox[{
            RowBox[{
             SubscriptBox["a", "i"], 
             RowBox[{"onde", "[", 
              RowBox[{"u", "-", 
               SubscriptBox["t", "i"]}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"u", ",", " ", "0", ",", " ", "5"}], "}"}], ",", " ", 
            RowBox[{"PlotRange", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", " ", "5"}], "}"}], ",", " ", "All"}], 
              "}"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "1", ",", " ", "n"}], "}"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.914436149790348*^9, 3.914436275067904*^9}, {
   3.914436329955169*^9, 3.91443652632252*^9}, {3.9144365688661346`*^9, 
