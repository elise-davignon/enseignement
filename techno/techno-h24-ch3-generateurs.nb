Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"On", " ", "choisit", " ", "un", " ", "nombre", " ", "premier"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"n", "=", 
    RowBox[{
     SuperscriptBox["2", "31"], "-", "1"}]}], ";", 
   RowBox[{"PrimeQ", "[", "n", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.916152063351543*^9, 3.916152084164585*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"990d076a-1979-6e4f-87e8-a08b0e945590"],

