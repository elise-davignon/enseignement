Cell["On peut alors g\[EAcute]n\[EAcute]rer toute la s\[EAcute]quence  :", \
"Text",
 CellChangeTimes->{{3.9163629498669815`*^9, 
  3.9163629859227295`*^9}},ExpressionUUID->"6be5750e-2b77-a743-be59-\
d3ff5eb1db52"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "On", " ", "g\[EAcute]n\[EGrave]re", " ", "toute", " ", "la", " ", 
    "s\[EAcute]quence", " ", 
    RowBox[{"jusqu", "'"}], "\[AGrave]", " ", "ce", " ", 
    RowBox[{"qu", "'"}], "elle", " ", "se", " ", 
    RowBox[{"r\[EAcute]p\[EGrave]te", "."}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"s\[EAcute]quence", "=", 
     RowBox[{"Mod", "[", 
      RowBox[{
       RowBox[{"B", ".", "xInit"}], ",", " ", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"While", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "=", 
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"A", ".", "x"}], ",", " ", "2"}], "]"}]}], ")"}], "!=", 
      "xInit"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"y", "=", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"B", ".", "x"}], ",", " ", "2"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"s\[EAcute]quence", "=", 
       RowBox[{"Join", "[", 
        RowBox[{"s\[EAcute]quence", ",", " ", "y"}], "]"}]}]}]}], 
    "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
   "s\[EAcute]quence"}]}]], "Input",
 CellChangeTimes->{{3.9163629871601753`*^9, 3.91636304105287*^9}, {
  3.9163630727496166`*^9, 3.916363078948929*^9}, {3.9163631284200172`*^9, 
  3.91636328061166*^9}, {3.916363390587761*^9, 3.916363490306923*^9}, {
  3.91636356175494*^9, 3.916363609114935*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"9dbf82e9-1ba2-894e-b7e4-79153218cc45"],

