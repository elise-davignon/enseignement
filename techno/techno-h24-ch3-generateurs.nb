Cell["\<\
On peut analyser les fr\[EAcute]quences pour les diff\[EAcute]rentes suites \
de bits :\
\>", "Text",
 CellChangeTimes->{{3.91636523733939*^9, 
  3.91636526643602*^9}},ExpressionUUID->"88042127-6ff0-ae4c-89bd-\
2502e31d71ef"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nbits", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"nombres", "=", 
  RowBox[{"Table", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FromDigits", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"s\[EAcute]quenceD\[EAcute]cal\[EAcute]e", "[", "i", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", "nbits"}], "]"}], "]"}], ",", " ", "2"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "0", ",", " ", 
      RowBox[{"l", "-", "1"}]}], "}"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"t", "=", 
    RowBox[{"Tally", "[", "nombres", "]"}]}], ",", " ", 
   RowBox[{"Filling", "->", "Axis"}], ",", " ", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", 
      RowBox[{"Max", "[", 
       RowBox[{
        RowBox[{"t", "[", 
