Cell[TextData[{
 "On d\[EAcute]finit une r\[EAcute]currence lin\[EAcute]aire (mod 2) avec la \
matrice ",
 StyleBox["A",
  FontSlant->"Italic"],
 " qui d\[EAcute]cale les bits et les combine pour obtenir le bit suivant. \
(Section 8.2)"
}], "Text",
 CellChangeTimes->{{3.916362253845867*^9, 3.9163622911568184`*^9}, 
   3.916362661148514*^9},ExpressionUUID->"22170a16-a1bf-2c48-8e3e-\
