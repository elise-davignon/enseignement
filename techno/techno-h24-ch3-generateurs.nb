Cell["\<\
On peut comparer la s\[EAcute]quence \[AGrave] une version \[LeftGuillemet]\
\[NonBreakingSpace]d\[EAcute]cal\[EAcute]e \[RightGuillemet]\
\[NonBreakingSpace]de celle-ci, pour v\[EAcute]rifier la corr\[EAcute]lation \
-- c\[CloseCurlyQuote]est \[AGrave] dire la diff\[EAcute]rence entre le \
nombre de bits qui sont \[EAcute]gaux et le nombre de bits qui sont diff\
\[EAcute]rents.\
\>", "Text",
 CellChangeTimes->{{3.916363757088377*^9, 3.91636379170434*^9}, {
  3.9163647565161095`*^9, 
  3.916364775508501*^9}},ExpressionUUID->"0c2165a1-ba13-7749-99cf-\
1e35e3e80c90"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Fonction", " ", "pour", " ", "d\[EAcute]caler", " ", 
    "p\[EAcute]riodiquement", " ", "une", " ", "s\[EAcute]quence"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"PermutationP\[EAcute]riodique", "[", 
      RowBox[{"liste_", ",", " ", "d_"}], "]"}], ":=", "\[IndentingNewLine]", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"liste", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"d", ",", " ", 
             RowBox[{"Length", "[", "liste", "]"}]}], "]"}], "+", "1"}], ";;", 
          RowBox[{"Length", "[", "liste", "]"}]}], "]"}], "]"}], ",", " ", 
       RowBox[{"liste", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"Mod", "[", 
           RowBox[{"d", ",", " ", 
            RowBox[{"Length", "[", "liste", "]"}]}], "]"}]}], "]"}], "]"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Fonction", " ", "qui", " ", "calcule", " ", "la", " ", 
     "corr\[EAcute]lation", " ", "entre", " ", "deux", " ", "listes"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Corr\[EAcute]lation", "[", 
      RowBox[{"liste1_", ",", " ", "liste2_"}], "]"}], ":=", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "liste1"], ".", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "liste2"]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "On", " ", "affiche", " ", "tous", " ", "les", " ", "d\[EAcute]calages", " ",
      "de", " ", "la", " ", "s\[EAcute]quence"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{"Join", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"\"\<S\[EAcute]quence d\[EAcute]cal\[EAcute]e\>\"", 
         ",", "\"\<Corr\[EAcute]lation\>\""}], "}"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
             "s\[EAcute]quenceD\[EAcute]cal\[EAcute]e", "[", "i", "]"}], "=", 
             RowBox[{"PermutationP\[EAcute]riodique", "[", 
              RowBox[{"s\[EAcute]quence", ",", " ", "i"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;"}], "]"}], "]"}], ",", 
          RowBox[{"Corr\[EAcute]lation", "[", 
           RowBox[{"s\[EAcute]quence", ",", " ", 
            RowBox[{
            "s\[EAcute]quenceD\[EAcute]cal\[EAcute]e", "[", "i", "]"}]}], 
           "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "0", ",", " ", 
          RowBox[{"l", "-", "1"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
     "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.916363805725296*^9, 3.916364270736494*^9}, {
  3.9163643553685303`*^9, 3.9163643665358105`*^9}, {3.9163644048961716`*^9, 
  3.9163644133759117`*^9}, {3.916364447656801*^9, 3.9163644546878033`*^9}, {
