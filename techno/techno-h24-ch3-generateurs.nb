Cell[TextData[{
 "La suite est g\[EAcute]n\[EAcute]r\[EAcute]e en consid\[EAcute]rant les \
vecteurs ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", 
      RowBox[{"n", "+", "1"}]], " ", "=", " ", 
     RowBox[{"A", " ", 
      SubscriptBox["x", "n"]}]}], ","}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "422924a7-5785-7848-90b7-9bfc1b495109"],
 " et la sortie ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "n"], "=", 
    RowBox[{"B", " ", 
     SubscriptBox["x", "n"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "47cf5b56-2172-5249-93c3-2f59c3dc2f6a"],
 ". Par exemple, si on veut r\[EAcute]cup\[EAcute]rer le premier bit, on \
prend B = (1, 0, ...., 0);"
}], "Text",
 CellChangeTimes->{{3.9163626558452396`*^9, 3.9163627398611526`*^9}, {
  3.916362840228096*^9, 
