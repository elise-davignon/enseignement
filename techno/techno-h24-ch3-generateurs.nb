Cell[TextData[{
 "Le g\[EAcute]n\[EAcute]rateur lin\[EAcute]aire congruentiel utilise le fait \
que G = {1, 2, 3, ..., n-1} avec la multiplication mod n est un ",
 StyleBox["groupe cyclique",
  FontWeight->"Bold"],
 " lorsque n est un nombre premier. "
}], "Text",
 CellChangeTimes->{{3.916152019291498*^9, 
  3.916152060785532*^9}},ExpressionUUID->"c4f177b7-7503-8d41-a196-\
33d038f22980"],

