Cell[TextData[{
 "On imagine qu\[CloseCurlyQuote]on se trouve \[AGrave] une ",
 StyleBox["position inconnue. ",
  FontWeight->"Bold"],
 "Ici, nous allons simuler cela en choisissant une position al\[EAcute]atoire \
",
 StyleBox["X",
  FontSlant->"Italic"],
 ", mais nous essayerons ensuite de la retrouver \[LeftGuillemet]\
\[NonBreakingSpace]sans tricher\[NonBreakingSpace]\[RightGuillemet]."
}], "Text",
 CellChangeTimes->{{3.91381110440479*^9, 3.913811124156419*^9}, {
  3.913811372475238*^9, 
  3.913811410155464*^9}},ExpressionUUID->"17cca96e-239b-4128-a21c-\
924396eabc64"],

Cell["\<\
Pour des raisons que nous verrons plus loin, on va se limiter \[AGrave] une \
pr\[EAcute]cision au milli\[EGrave]me d\[CloseCurlyQuote]unit\[EAcute]s, et \
on va tout conserver sous forme d\[CloseCurlyQuote]entiers pour que \
Mathematica puisse faire les calculs sous forme symbolique et conserver une \
pr\[EAcute]cision infinie.\
\>", "Text",
 CellChangeTimes->{{3.9139200160039234`*^9, 
  3.913920066171488*^9}},ExpressionUUID->"0f517839-5125-9844-bdfb-\
da47993e13c9"],

