Cell[TextData[{
 "On remarque que l\[CloseCurlyQuote]ensemble des solutions est vide! \
Pourquoi?\nC\[CloseCurlyQuote]est parce qu\[CloseCurlyQuote]on cherche le \
point de ",
 StyleBox["triple-intersection",
  FontWeight->"Bold"],
 " de trois cercles  :"
}], "Text",
