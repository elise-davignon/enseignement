Cell["Une autre m\[EAcute]thode", "Section",
 CellChangeTimes->{{3.9139204007867527`*^9, 
  3.9139204028984146`*^9}},ExpressionUUID->"6160acea-8714-b446-9e50-\
4491ffd10322"],

Cell["\<\
On peut \[EAcute]galement solutionner le probl\[EGrave]me en utilisant, m\
\[EHat]me dans Mathematica, le truc vu en classe, soit de soustraire les \
\[EAcute]quations l\[CloseCurlyQuote]une de l\[CloseCurlyQuote]autre. On fait \
par exemple :\
\>", "Text",
 CellChangeTimes->{{3.9139204125108967`*^9, 
  3.9139204415215855`*^9}},ExpressionUUID->"316abba3-a066-2541-bd87-\
d3acf10bf653"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Syst\[EGrave]me d'\[EAcute]quations original : \>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sysEq", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      SubscriptBox["eq", "i"], "=", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["r", "i"], "2"], "==", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "-", 
            SubscriptBox["x", "i"]}], ")"}], "2"], "+", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"y", "-", 
            SubscriptBox["y", "i"]}], ")"}], "2"]}]}], ")"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Soustraire", " ", "des", " ", "\[EAcute]quations", " ", "est", " ", 
     "compliqu\[EAcute]"}], ",", " ", 
    RowBox[{
    "il", " ", "faut", " ", "convertir", " ", "les", " ", "\[EAcute]quations",
      " ", "en", " ", "listes"}], ",", " ", 
    RowBox[{"puis", " ", "les", " ", "reconvertir", " ", "en", " ", 
     RowBox[{"\[EAcute]quations", ".", "\[IndentingNewLine]", "ici"}]}], ",", 
    " ", 
    RowBox[{
     RowBox[{
      RowBox[{"l", "'"}], "\[EAcute]quation", " ", "lin\[EAcute]aire", " ", 
      "i", " ", "est", " ", 
      SubscriptBox["eq", "i"]}], " ", "-", " ", 
     SubscriptBox["eq", "3"]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", 
   "\"\< Syst\[EGrave]me d'\[EAcute]quations lin\[EAcute]aire \
\[EAcute]quivalent : \>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"sysEqLin", "=", 
  RowBox[{"Table", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     SubscriptBox["eqLin", "i"], "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Equal", "@@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"List", "@@", 
          SubscriptBox["eq", "i"]}], "-", 
         RowBox[{"List", "@@", 
          SubscriptBox["eq", "3"]}]}], ")"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "1", ",", " ", "2"}], "}"}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.9139204439092216`*^9, 3.913920514258156*^9}, {
  3.913920549378685*^9, 3.913920562634554*^9}, {3.9139206412745914`*^9, 
  3.9139207506015015`*^9}, {3.913920782219551*^9, 3.913920872913946*^9}},
 CellLabel->
