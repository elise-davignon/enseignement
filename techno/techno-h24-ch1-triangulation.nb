Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"25.95850910043755`", "\[Equal]", 
    RowBox[{
     SuperscriptBox["x", "2"], "+", 
     SuperscriptBox["y", "2"]}]}], ",", 
   RowBox[{"13.221792392715185`", "\[Equal]", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"4", "+", "x"}], ")"}], "2"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "2"}], "+", "y"}], ")"}], "2"]}]}], ",", 
   RowBox[{"67.59341868715809`", "\[Equal]", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "2"}], "+", "x"}], ")"}], "2"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "3"}], "+", "y"}], ")"}], "2"]}]}]}], "}"}]], "Output",
