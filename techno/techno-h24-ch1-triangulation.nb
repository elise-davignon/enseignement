Cell[CellGroupData[{

Cell["En pratique", "Section",
 CellChangeTimes->{{3.913916191207863*^9, 
  3.9139161927111797`*^9}},ExpressionUUID->"fd7ceb43-9972-7743-a7d7-\
36b721446221"],

Cell["\<\
On remarque qu\[CloseCurlyQuote]on a du choisir un point al\[EAcute]atoire au \
milli\[EGrave]me pr\[EGrave]s, afin de pr\[EAcute]server une \
pr\[EAcute]cision infinie dans les calculs avec Mathematica. En pratique, par \
contre, les donn\[EAcute]es dont on dispose ne seront pas infiniment pr\
\[EAcute]cises, et il faudra se permettre des approximations.\
\>", "Text",
 CellChangeTimes->{{3.9139162020308075`*^9, 
  3.9139163114307785`*^9}},ExpressionUUID->"86a0df6f-a43a-af4c-9d51-\
553e7ac8460d"],

Cell["\<\
On refait ici le m\[EHat]me proc\[EAcute]d\[EAcute] de triangulation, mais \
avec des distances \[LeftGuillemet]\[NonBreakingSpace]impr\[EAcute]cises\
\[NonBreakingSpace]\[RightGuillemet].\
\>", "Text",
 CellChangeTimes->{{3.9139163200786514`*^9, 3.9139163444148426`*^9}, {
  3.913916707102417*^9, 
  3.9139167097099457`*^9}},ExpressionUUID->"e1b81f3e-76f5-554d-b3c9-\
fa06a3f15fc0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Coordonn\[EAcute]es", " ", "des", " ", "points", " ", "de", " ", 
     "rep\[EGrave]re"}], ",", " ", "connus"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["P", "1"], "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0"}], "}"}]}], ";", 
    RowBox[{
     SubscriptBox["P", "2"], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4"}], ",", " ", "2"}], "}"}]}], ";", " ", 
    RowBox[{
     SubscriptBox["P", "3"], "=", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["x", "i"], ",", " ", 
         SubscriptBox["y", "i"]}], "}"}], "=", 
       SubscriptBox["P", "i"]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Rep\[EGrave]res : \>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\!\(\*SubscriptBox[\(P\), \(1\)]\) = \>\"", ",", " ", 
      SubscriptBox["P", "1"]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\!\(\*SubscriptBox[\(P\), \(2\)]\) = \>\"", ",", " ", 
      SubscriptBox["P", "2"]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\!\(\*SubscriptBox[\(P\), \(3\)]\) = \>\"", ",", " ", 
      SubscriptBox["P", "3"]}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Point", " ", "que", " ", 
     RowBox[{"l", "'"}], "on", " ", "d\[EAcute]sire", " ", "trianguler"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"X", "=", 
     RowBox[{
      RowBox[{"N", "@", "X"}], "+", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", ".0005"}], ",", " ", ".0005"}], "}"}], ",", "2"}], 
       "]"}]}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "On", " ", "ajoute", " ", "une", " ", "petite", " ", "perturbation", " ", 
     "al\[EAcute]atoire", " ", "au", " ", "point", " ", "inconnu"}], " ", 
    "*)"}], " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", "Distances", " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       SubscriptBox["r", "i"], "=", 
       RowBox[{"Norm", "[", 
        RowBox[{"X", "-", 
         SubscriptBox["P", "i"]}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\\nDistances : \>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\!\(\*SubscriptBox[\(r\), \(1\)]\) = \>\"", ",", " ", 
      SubscriptBox["r", "1"]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\!\(\*SubscriptBox[\(r\), \(2\)]\) = \>\"", ",", " ", 
      SubscriptBox["r", "2"]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\!\(\*SubscriptBox[\(r\), \(3\)]\) = \>\"", ",", " ", 
      SubscriptBox["r", "3"]}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Le", " ", "syst\[EGrave]me", " ", 
     RowBox[{"d", "'"}], "\[EAcute]quations"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\nSyst\[EGrave]me d'\[EAcute]quations : \>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"sysEq", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        SubscriptBox["r", "i"], "2"], "==", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", 
           SubscriptBox["x", "i"]}], ")"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"y", "-", 
           SubscriptBox["y", "i"]}], ")"}], "2"]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "1", ",", " ", "3"}], "}"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Solutions : \>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Solve", "[", 
    RowBox[{"sysEq", ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}]}]}]], "Input",
